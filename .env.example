# Local dev uses the embedded Postgres started by `npm run db:up`.
#
# In production these are two different Neon strings. DATABASE_URL is the
# **pooled** one (host contains `-pooler`) — serverless functions open a
# connection per request and would exhaust the limit without it. DIRECT_URL is
# the same string with `-pooler` removed, and is used only by `prisma migrate`,
# which needs locks the pooler can't hold.
#
# Locally both point at the same embedded Postgres; there's no pooler involved.
DATABASE_URL="postgresql://tilltrack:tilltrack@localhost:54329/tilltrack"
DIRECT_URL="postgresql://tilltrack:tilltrack@localhost:54329/tilltrack"

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-min-32-characters"

# Only read by `npm run db:setup` / `db:bootstrap` when first creating the club.
# Not needed by the running app — pass it on the command line instead of storing
# it, so the admin password never lands in a file.
# ADMIN_PASSWORD=""
